extends ../layout

block content
  .d-none(data-main-width='wide')
  .d-flex.justify-content-between.align-items-center.mb-3
    h2.mb-0.text-white Catalogue
    .d-flex.gap-2
      a.btn.btn-secondary(href='/admin/stock') Back to Stock
      a.btn.btn-secondary(href='/admin/services') Back to services

  hr
  p.text-muted-light.small.mb-3
    | Catalogue defines count-units (global). No stock is stored here. Stock exists per store.

  .card.mb-4.dark-surface
    .card-body.dark-card-body
      .row.g-3.align-items-end.mb-3
        .col-12.col-md-7.col-lg-5
          label.form-label.text-muted-light(for='catalogueCategoryFilter') Display category
          select.form-select#catalogueCategoryFilter
            each category in (categories || [])
              option(value=category._id selected=String(selectedCategoryId) === String(category._id))= category.name
            option(value='uncategorized' selected=selectedCategoryId === 'uncategorized') Uncategorized (#{Number(uncategorizedCount || 0)})
        .col-12.col-md-auto
          button.btn.btn-outline-light-custom.w-100(type='button', id='manageCatalogueCategoriesBtn')
            i.bi.bi-folder-plus.me-1
            | Manage categories
      .d-flex.align-items-center.gap-2.mb-3
        span.spinner-border.spinner-border-sm.text-info#catalogueListSpinner(style='display:none;' aria-hidden='true')
        small.text-muted-light#catalogueFilterStatus Catalogue items in the selected category
      .table-responsive
        table.table.table-striped.table-hover.table-sm#catalogueItemsTable
          thead
            tr
              th.text-white Material
              th.text-muted-light Stock units
              th.text-center.text-muted-light Actions
          tbody#catalogueTableBody
            if materials && materials.length
              each m in materials
                - const mUnits = (m.stockUnits && m.stockUnits.length) ? m.stockUnits : [{ name: (m.baseUnitName || 'piece'), factor: 1, isBase: true }];
                - const unitSummary = mUnits.map(u => Number(u.factor || 1) === 1 ? `${u.name} (base)` : `${u.name} = ${u.factor} ${m.baseUnitName || 'piece'}`).join(' | ');
                - const materialCategoryId = m.category && m.category._id ? String(m.category._id) : 'uncategorized';
                tr(data-id=m._id data-category-id=materialCategoryId)
                  td
                    strong.text-white.catalogue-material-name= m.name
                    if m.selections && m.selections.length
                      br
                      small.text-muted-light
                        - const labels = m.selections.map(s => (s.unit && s.unit.name ? s.unit.name + ': ' + (s.subUnit && s.subUnit.name ? s.subUnit.name : s.subUnit) : '')).filter(Boolean);
                        = labels.join(' + ')
                    else
                      br
                      small.text-muted-light Standalone material
                  td
                    small.text-muted-light.catalogue-unit-summary= unitSummary
                  td.text-center
                    .d-inline-flex.gap-2.justify-content-center.flex-wrap
                      button.btn.btn-sm.btn-outline-light-custom.configure-units-btn(
                        data-id=m._id
                        data-name=m.name
                        data-category-id=materialCategoryId
                        data-base-unit=(m.baseUnitName || 'piece')
                        data-units=JSON.stringify(mUnits)
                        type='button'
                      ) Edit
                      button.btn.btn-sm.btn-outline-danger.delete-catalogue-btn(data-id=m._id type='button') Delete
            else
              tr#catalogueEmptyRow
                td.text-muted(colspan='3') No catalogue items in this category.

  // Create Catalogue
  .card.mb-4.dark-surface
    .card-body.dark-card-body
      h5.mb-3.text-white Create catalogue item (global)
      form#create-catalogue-form(class='row g-3' novalidate)
        .col-12.col-md-4
          label.form-label(for='cuCategory') Category
          select.form-select#cuCategory(required disabled=!(categories && categories.length))
            if categories && categories.length
              each category in categories
                option(value=category._id selected=String(selectedCategoryId) === String(category._id))= category.name
            else
              option(value='') Create a category first
          small.text-muted-light Catalogue items must be assigned to a category.

        .col-12.col-md-8
          label.form-label(for='cuName') Name
          input.form-control(type='text', id='cuName', placeholder='e.g. A3 STD paper' required)

        .col-12
          small.text-muted-light.mb-2 Service-rule matching is optional. Select sub-units only when this material should auto-match normal price rules; leave empty for Large Format or general stock materials.

        .col-12.col-md-4
          label.form-label(for='baseUnitName') Smallest stock unit
          input.form-control(type='text', id='baseUnitName', value='piece', placeholder='e.g. sheet, ml, piece' required)
          small.text-muted-light Orders consume stock in this smallest unit.

        .col-12.col-md-8
          label.form-label Stock purchase units
          .table-responsive
            table.table.table-sm.align-middle.mb-2#stockUnitsTable
              thead
                tr
                  th Unit name
                  th Equals how many smallest units
                  th.text-end
              tbody
          button.btn.btn-sm.btn-outline-light-custom(type='button', id='addStockUnitRowBtn')
            i.bi.bi-plus-circle.me-1
            | Add unit
          small.text-muted-light.d-block.mt-1 Example: ream = 500 sheets, box/carton = 2500 sheets.

        .col-12
          .card.dark-surface(style='border:1px solid rgba(33,188,255,.22);box-shadow:0 12px 30px rgba(0,0,0,.10);')
            .card-header.bg-transparent.border-0.p-2
              button.btn.btn-sm.btn-outline-light-custom.w-100.d-flex.align-items-center.justify-content-between(type='button', data-bs-toggle='collapse', data-bs-target='#catalogueUnitsMasterCollapse', aria-expanded='false', aria-controls='catalogueUnitsMasterCollapse')
                span.d-flex.align-items-center.gap-2
                  i.bi.bi-layers
                  span.fw-semibold Service-rule matching units
                  span.badge.rounded-pill.bg-info.text-dark Optional
                span.small.text-muted-light Expand to select sub-units
            .collapse#catalogueUnitsMasterCollapse
              .card-body.dark-card-body.pt-0
                .accordion#catalogueUnitsAccordion.dark-surface
                  each unit in units
                    - const uid = unit._id
                    .accordion-item
                      h2.accordion-header
                        button.accordion-button.collapsed(type='button', data-bs-toggle='collapse', data-bs-target=`#u-${uid}`, aria-expanded='false')
                          span.text-white #{unit.name}
                      .accordion-collapse.collapse(id=`u-${uid}`)
                        .accordion-body
                          ul.list-group
                            each su in subunits.filter(s=>String(s.unit) === String(uid))
                              li.list-group-item
                                label.form-check
                                  input.form-check-input.unit-sub-checkbox(data-unit=uid data-subunit=su._id type='checkbox')
                                  |&nbsp;
                                  span= su.name

        .col-12.text-end
          button.btn.btn-primary(type='button' id='createCatalogueBtn' disabled=!(categories && categories.length))
            span.spinner-border.spinner-border-sm.me-2(style='display:none;' id='createCatalogueSpinner')
            | Create

  // Delete confirm modal
  .modal.fade(id='deleteConfirmModal', tabindex='-1', aria-hidden='true')
    .modal-dialog.modal-dialog-centered
      .modal-content
        .modal-header
          h5.modal-title Confirm delete
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
        .modal-body
          p#deleteConfirmMessage Are you sure you want to delete this item?
          p.text-muted.small.mt-2 Deleting cannot be undone.
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Cancel
          button.btn.btn-outline-danger(type='button', id='confirmDeleteBtn') Yes, delete

  // Catalogue category manager
  .modal.fade(id='catalogueCategoryModal', tabindex='-1', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content.dark-surface
        .modal-header
          .d-flex.flex-column
            h5.modal-title.text-white Catalogue categories
            small.text-muted-light Create categories before assigning catalogue items.
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
        .modal-body.dark-card-body
          .row.g-2.align-items-end
            .col-12.col-md
              label.form-label.text-muted-light(for='newCatalogueCategoryName') New category name
              input.form-control#newCatalogueCategoryName(type='text', maxlength='100', placeholder='e.g. Papers')
            .col-12.col-md-auto
              button.btn.btn-primary.w-100#createCatalogueCategoryBtn(type='button')
                span.spinner-border.spinner-border-sm.me-2#createCatalogueCategorySpinner(style='display:none;')
                | Create category
          hr.my-4
          .d-flex.justify-content-between.align-items-center.mb-2
            h6.text-white.mb-0 Existing categories
            small.text-muted-light#uncategorizedCategoryCount #{Number(uncategorizedCount || 0)} uncategorized
          .d-grid.gap-2#catalogueCategoryManagerList
            if categories && categories.length
              each category in categories
                .catalogue-category-manager-row.border.rounded.p-2(data-category-id=category._id)
                  .row.g-2.align-items-center
                    .col-12.col-md
                      input.form-control.form-control-sm.catalogue-category-name(type='text', value=category.name, maxlength='100')
                    .col-auto
                      span.badge.bg-info.text-dark.catalogue-category-count 0 items
                    .col-auto
                      button.btn.btn-sm.btn-outline-light-custom.save-catalogue-category-btn(type='button') Save
                    .col-auto
                      button.btn.btn-sm.btn-outline-danger.delete-catalogue-category-btn(type='button') Delete
            else
              p.text-muted-light.mb-0#noCatalogueCategoriesMessage No categories created yet.
          .alert.alert-info.mt-3.mb-0.py-2
            small To move existing items, select "Uncategorized" in the catalogue filter, click Edit on an item, then choose its category.

  // Catalogue edit modal
  .modal.fade(id='unitConfigModal', tabindex='-1', aria-hidden='true')
    .modal-dialog.modal-dialog-centered.modal-lg
      .modal-content.dark-surface
        .modal-header
          h5.modal-title.text-white Edit catalogue item
          button.btn-close(type='button', data-bs-dismiss='modal', aria-label='Close')
        .modal-body.dark-card-body
          input(type='hidden', id='unitMaterialId')
          .row.g-3.mb-3
            .col-12.col-md-4
              label.form-label.text-muted-light(for='unitMaterialNameInput') Catalogue name
              input.form-control#unitMaterialNameInput(type='text', required)
            .col-12.col-md-4
              label.form-label.text-muted-light(for='unitMaterialCategory') Category
              select.form-select#unitMaterialCategory
                option(value='uncategorized') Uncategorized
                each category in (categories || [])
                  option(value=category._id)= category.name
              small.text-muted-light Use this to move existing items.
            .col-12.col-md-4
              label.form-label.text-muted-light(for='unitBaseName') Smallest stock unit
              input.form-control#unitBaseName(type='text', value='piece', required)
              small.text-muted-light Orders consume stock in this smallest unit.
          .mb-2
            h6.text-white.mb-1 Stock purchase units
            small.text-muted-light Configure purchase units for this catalogue item.
          .table-responsive
            table.table.table-sm.align-middle#unitConfigTable
              thead
                tr
                  th Unit name
                  th Equals how many smallest units
                  th.text-end
              tbody#unitConfigRows
          button.btn.btn-sm.btn-outline-light-custom(type='button', id='addUnitConfigRowBtn')
            i.bi.bi-plus-circle.me-1
            | Add unit
        .modal-footer
          button.btn.btn-secondary(type='button', data-bs-dismiss='modal') Cancel
          button.btn.btn-primary(type='button', id='saveUnitConfigBtn')
            span.spinner-border.spinner-border-sm.me-2(style='display:none;' id='saveUnitConfigSpinner')
            | Save changes
  // Keep Catalogue page scripts inside #main-content so dashboard_nav AJAX loads them
  script(src='/javascripts/catalogue.js')
